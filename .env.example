# Recommended: scripts/prepare-local.ps1 generates .local/integration.env automatically.
# Standalone process settings, if using an explicitly managed local database:
PORT=8081
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/installation_db
SPRING_DATASOURCE_USERNAME=smartgn_installation
SPRING_DATASOURCE_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-the-same-strong-key-as-IAM
JWT_ISSUER=smartgn-iam-service
JWT_AUDIENCE=smartgn-api
DEVICE_CREDENTIAL_KEY=replace-with-base64-of-32-random-bytes
INTERNAL_SERVICE_TOKEN=replace-with-the-same-strong-service-token-as-IAM
SMARTGN_IAM_BASE_URL=http://localhost:8080
TELEMETRY_BASE_URL=http://localhost:8090
EMQX_API_URL=http://localhost:18083/api/v5
EMQX_API_KEY=replace-with-a-random-api-key
EMQX_API_SECRET=replace-with-a-random-api-secret
EMQX_PASSWORD=replace-with-a-dashboard-password
ALLOWED_ORIGINS=http://localhost:4200
